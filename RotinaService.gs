function listarAtividadesICP_(){return opsRows_('atividades').reverse().slice(0,500)}
function salvarAtividadeICP_(p){p=p||{};if(p.id){opsUpdate_('atividades',p.id,{'Responsável':textoICP_(p.responsavel,100),'Status':textoICP_(p.status,50),'Repetindo':textoICP_(p.repetindo,10),'Resolução':textoICP_(p.resolucao,500),'Resultado':textoICP_(p.resultado,80),'Atualizado em':agoraISOICP_()});return {ok:true,id:p.id}}
 const id=novoIdICP_('ATV');opsAppend_('atividades',{'ID':id,'Nº Atividade':textoICP_(p.numero,40),'CR':textoICP_(p.cr,40),'Amostra':textoICP_(p.amostra,100),'Cliente':textoICP_(p.cliente,160),'Parâmetro':textoICP_(p.parametro,160),'Motivo':textoICP_(p.motivo,500),'Responsável':textoICP_(p.responsavel,100),'Status':p.status||'Aberta','Repetindo':p.repetindo||'Não','Resolução':textoICP_(p.resolucao,500),'Resultado':textoICP_(p.resultado,80),'Criado em':agoraISOICP_(),'Atualizado em':agoraISOICP_()});return {ok:true,id}}
