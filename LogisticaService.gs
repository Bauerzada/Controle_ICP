const ICP_FONTES = Object.freeze({requisicoes:'10UcZcsIKUPQCxAeDDsBD1mLp652nBa-_xvjI06An9-U',atividades:'1Gihv011u3IPCv-KLa0AbZR9v6JooynSIMu9tGemuxdw'});
function listarRequisicoesICP_(){const ss=SpreadsheetApp.openById(ICP_FONTES.requisicoes),sh=ss.getSheetByName('Requisições ICP');if(!sh)return[];const v=sh.getDataRange().getDisplayValues();return v.slice(5).filter(r=>r[0]).map((r,i)=>({linha:i+6,numero:r[0],item:r[1],categoria:r[2],status:r[3]||'Pendente',data:r[4],responsavel:r[5],observacoes:r[6]}))}
function atualizarRequisicaoICP_(p){p=p||{};const linha=Number(p.linha);if(!linha||linha<6)throw new Error('Linha de requisição inválida.');const ss=SpreadsheetApp.openById(ICP_FONTES.requisicoes),sh=ss.getSheetByName('Requisições ICP');if(!sh)throw new Error('Aba Requisições ICP não encontrada.');const lock=LockService.getScriptLock();lock.waitLock(15000);try{sh.getRange(linha,4).setValue(textoICP_(p.status,50));if(p.responsavel!=null)sh.getRange(linha,6).setValue(textoICP_(p.responsavel,100));if(p.observacoes!=null)sh.getRange(linha,7).setValue(textoICP_(p.observacoes,500));SpreadsheetApp.flush();return {ok:true}}finally{lock.releaseLock()}}
function listarCaixasICP_(){return opsRows_('caixas').reverse().slice(0,1000)}
function registrarCaixaICP_(p){p=p||{};if(!p.caixa||!p.amostra)throw new Error('Informe caixa e amostra.');const id=novoIdICP_('CX');opsAppend_('caixas',{'ID':id,'Caixa':textoICP_(p.caixa,60),'Amostra':textoICP_(p.amostra,60),'Embalagem':textoICP_(p.embalagem,30),'Status':p.status||'Armazenada','Responsável':textoICP_(p.responsavel,100),'Data':p.data||new Date(),'Observações':textoICP_(p.observacoes,500)});return {ok:true,id}}
