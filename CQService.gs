function listarCQICP_(){return opsRows_('cq').reverse().slice(0,500)}
function registrarCQICP_(p){p=p||{};if(!p.tipo||!p.metodo)throw new Error('Informe tipo de CQ e método.');const res=Number(String(p.resultado||'').replace(',','.')),li=p.li===''||p.li==null?null:Number(String(p.li).replace(',','.')),ls=p.ls===''||p.ls==null?null:Number(String(p.ls).replace(',','.'));if(!isFinite(res))throw new Error('Resultado inválido.');let status='Registrado';if(li!=null&&isFinite(li)&&res<li)status='Fora do limite';if(ls!=null&&isFinite(ls)&&res>ls)status='Fora do limite';if(status==='Registrado'&&(li!=null||ls!=null))status='Conforme';const id=novoIdICP_('CQ');opsAppend_('cq',{'ID':id,'Tipo':textoICP_(p.tipo,80),'Método':textoICP_(p.metodo,80),'Resultado':res,'Unidade':textoICP_(p.unidade,30),'Limite inferior':li==null?'':li,'Limite superior':ls==null?'':ls,'Status':status,'Curva ID':textoICP_(p.curvaId,80),'Responsável':textoICP_(p.responsavel,100),'Data':p.data||new Date(),'Observações':textoICP_(p.observacoes,500),'Criado em':agoraISOICP_()});return {ok:true,id,status}}
