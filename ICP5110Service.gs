function listarSequenciasICP_(){return opsRows_('sequencias').reverse().slice(0,300)}
function salvarSequenciaICP_(p){p=p||{};if(!p.nome)throw new Error('Informe o nome da sequência.');const id=novoIdICP_('SEQ'),ams=textoICP_(p.amostras,2000);opsAppend_('sequencias',{'ID':id,'Nome':textoICP_(p.nome,120),'Método':textoICP_(p.metodo,80),'Amostras':ams,'Quantidade':ams?ams.split(/[;,\n]+/).filter(Boolean).length:0,'Responsável':textoICP_(p.responsavel,100),'Status':p.status||'Planejada','Início':p.inicio||'','Fim':p.fim||'','Observações':textoICP_(p.observacoes,500),'Criado em':agoraISOICP_(),'Atualizado em':agoraISOICP_()});return {ok:true,id}}
function listarEquipamentoICP_(){return opsRows_('equipamento').reverse().slice(0,300)}
function registrarEquipamentoICP_(p){p=p||{};if(!p.tipo||!p.descricao)throw new Error('Informe tipo e descrição.');const id=novoIdICP_('EQP');opsAppend_('equipamento',{'ID':id,'Tipo':textoICP_(p.tipo,80),'Descrição':textoICP_(p.descricao,500),'Status':p.status||'Aberto','Responsável':textoICP_(p.responsavel,100),'Data':p.data||new Date(),'Próxima ação':textoICP_(p.proxima,300),'Observações':textoICP_(p.observacoes,500),'Criado em':agoraISOICP_(),'Atualizado em':agoraISOICP_()});return {ok:true,id}}
function listarErrosICP_(){return opsRows_('erros').reverse().slice(0,500)}
function registrarErroICP_(p){p=p||{};if(!p.titulo||!p.solucao)throw new Error('Informe título e solução aplicada.');const id=novoIdICP_('ERR');opsAppend_('erros',{'ID':id,'Código':textoICP_(p.codigo,80),'Título':textoICP_(p.titulo,160),'Sintoma':textoICP_(p.sintoma,500),'Causa':textoICP_(p.causa,500),'Solução':textoICP_(p.solucao,1000),'Responsável':textoICP_(p.responsavel,100),'Data':p.data||new Date(),'Evidência':textoICP_(p.evidencia,500),'Criado em':agoraISOICP_(),'Atualizado em':agoraISOICP_()});return {ok:true,id}}
